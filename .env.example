# Copy to .env and fill in any cloud/gated keys you plan to use.
# Local models (VibeVoice, faster-whisper, Ollama, vLLM, llama-server, sherpa-onnx) work with zero API keys!

# LLM (OpenAI-compatible endpoint)
A2N_LLM_BASE_URL=http://127.0.0.1:11434/v1
A2N_LLM_MODEL=qwen2.5:7b
A2N_LLM_API_KEY=ollama

# Optional cloud LLM / ASR API keys
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=

# Optional ASR OpenAI-compatible override
# A2N_ASR_BASE_URL=https://api.openai.com/v1
# A2N_ASR_MODEL=whisper-1
# A2N_ASR_API_KEY=

# Optional Hugging Face token (only required for pyannote.audio gated model download)
HF_TOKEN=
